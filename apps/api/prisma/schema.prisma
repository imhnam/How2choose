generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
  PAYMENT_REVIEW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ShipmentStatus {
  NOT_CREATED
  CREATED
  FAILED
}

model User {
  id String @id @default(cuid())
  email String? @unique
  phone String? @unique
  googleSub String? @unique
  passwordHash String?
  displayName String?
  role UserRole @default(USER)
  avatarObjectKey String?
  addressRecipientName String?
  addressPhone String?
  addressVersion String?
  addressProvinceCode Int?
  addressProvinceName String?
  addressDistrictCode Int?
  addressDistrictName String?
  addressWardCode Int?
  addressWardName String?
  addressLine String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  recipients Recipient[]
  orders Order[]
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Recipient {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  displayName String
  relationship String?
  interests String[]
  dislikes String[]
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, createdAt])
}

model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  priceVnd Int
  stock Int @default(0)
  tags String[]
  brand String?
  supplier String?
  shippingRegions String[]
  purchaseCount Int @default(0)
  ratingAverage Float @default(0)
  ratingCount Int @default(0)
  discountPercent Int?
  discountAmountVnd Int?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media ProductMedia[]
  categories ProductCategory[]
  variants ProductVariant[]
}

model Category {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String?
  parentId String?
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products ProductCategory[]
  @@index([parentId, sortOrder])
}

model ProductCategory {
  productId String
  categoryId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku String @unique
  name String?
  color String?
  size String?
  material String?
  priceVnd Int
  stock Int @default(0)
  packageWeightGram Int?
  packageLengthCm Int?
  packageWidthCm Int?
  packageHeightCm Int?
  discountPercent Int?
  discountAmountVnd Int?
  active Boolean @default(true)
  media ProductMedia[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems OrderItem[]
  @@index([productId, active])
}

model ProductMedia {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type ProductMediaType
  objectKey String @unique
  originalName String
  mimeType String
  sizeBytes Int
  sortOrder Int @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  status OrderStatus @default(PENDING_PAYMENT)
  recipientName String
  phone String
  addressVersion String
  provinceCode Int
  provinceName String
  districtCode Int?
  districtName String?
  wardCode Int
  wardName String
  addressLine String
  deliveryNote String?
  subtotalVnd Int
  shippingFeeVnd Int
  totalVnd Int
  packageWeightGram Int
  packageLengthCm Int
  packageWidthCm Int
  packageHeightCm Int
  ghnServiceTypeId Int
  expiresAt DateTime
  idempotencyKey String
  requestHash String
  paidAt DateTime?
  shipmentStatus ShipmentStatus @default(NOT_CREATED)
  ghnOrderCode String? @unique
  ghnShipmentError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  payment PaymentAttempt?
  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName String
  sku String
  variantName String
  originalUnitPriceVnd Int
  discountVnd Int
  unitPriceVnd Int
  quantity Int
  lineTotalVnd Int
  packageWeightGram Int
  packageLengthCm Int
  packageWidthCm Int
  packageHeightCm Int
  @@index([orderId])
}

model PaymentAttempt {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider String @default("VNPAY_SANDBOX")
  txnRef String @unique
  gatewayTransactionNo String? @unique
  amountVnd Int
  status PaymentStatus @default(PENDING)
  responseCode String?
  bankCode String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
