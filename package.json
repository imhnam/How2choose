{
  "name": "howtochoose",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w @howtochoose/web\" \"npm run dev -w @howtochoose/api\"",
    "build": "npm run db:generate && npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w @howtochoose/api",
    "check": "npm run lint && npm run typecheck && npm test",
    "setup": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @howtochoose/api",
    "db:validate": "npm run db:validate -w @howtochoose/api",
    "db:migrate": "npm run db:migrate -w @howtochoose/api --",
    "db:deploy": "npm run db:deploy -w @howtochoose/api",
    "db:studio": "npm run db:studio -w @howtochoose/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  }
}
